{
  "version": "landmark-v1",
  "seed": 731,
  "prediction_window_days": 90,
  "date_rule": "entire_reported_start_interval_after_snapshot_and_within_window",
  "baseline_statuses": ["not_yet_recruiting", "recruiting", "enrolling_by_invitation"],
  "baseline_years": [2018, 2019, 2020, 2021],
  "outcome_followup_years": 5,
  "labels": {"completed": 0, "terminated": 1},
  "train_years": [2018, 2019],
  "validation_year": 2020,
  "test_year": 2021,
  "validation_partition": "sha256(normalized_lead_sponsor) modulo 2: 0=tuning,1=calibration",
  "primary_comparison": "structured_tfidf_minus_structured_logistic",
  "primary_metric": "average_precision",
  "logistic_C": [0.03, 0.1, 0.3, 1.0],
  "boosting_candidates": [{"max_depth": 2, "min_child_weight": 5}, {"max_depth": 2, "min_child_weight": 15}, {"max_depth": 3, "min_child_weight": 5}, {"max_depth": 3, "min_child_weight": 15}],
  "boosting_trees": 150,
  "boosting_learning_rate": 0.04,
  "calibration": "Platt logistic slope/intercept on disjoint 2020 calibration sponsors; raw and isotonic diagnostic comparisons",
  "decision_threshold": 0.5,
  "review_fractions": [0.05, 0.1, 0.2],
  "bootstrap_replicates": 1000,
  "bootstrap_unit": "lead sponsor cluster within held-out cohort",
  "model_selection": "highest tuning average precision, predeclared list order breaks ties; no test-driven changes",
  "sensitivity": ["possible_date_interval", "withdrawn_plus_terminated_vs_completed", "no_facility_features", "zero_numeric_imputation", "test_without_near_duplicate_training_text"],
  "release_scope": "local retrospective research demonstrator; not a prospective or clinical deployment"
}
